# Copy these healthcare-only settings into the workspace (parent) .env,
# or export them in the process environment. Never commit real credentials.
LLM_PROVIDER=openai
OPENAI_MODEL=gpt-5.6-sol
GPT_SOL_API_KEY=replace-with-deployment-key
GPT_SOL_ENDPOINT=https://meeting-summarizer-ai.services.ai.azure.com/openai/v1
OPENAI_TIMEOUT=300
# Requested experiment value only: this deployment rejects the temperature API
# parameter. It is omitted; effective sampling is deployment-default, NOT 0.
OPENAI_TEMPERATURE=0
OPENAI_MAX_OUTPUT_TOKENS=8192
OPENAI_MAX_INPUT_BYTES=100000
# Optional paid real integration test; disabled by default.
# RUN_GPT_INTEGRATION=1
